# Copy to .env.local (gitignored). Never commit real values.

# --- Anthropic (server only) ---
# Required for real generation. Unset + MOCK_LLM=1 for local dev and tests.
ANTHROPIC_API_KEY=
# Optional: override the default fast model used for rewriting.
LLM_MODEL=
# Set to 1 to use deterministic fixtures instead of calling the API (all tests use this).
MOCK_LLM=1

# --- Database (required in production) ---
# Any Postgres connection string (Supabase transaction pooler on port 6543, or Neon).
# Run `pnpm db:migrate` once against it. Unset = in-process Postgres (PGlite), fine for local use.
DATABASE_URL=
# Set to 1 to force the in-process database even if DATABASE_URL is set.
MOCK_DB=1

# --- Supabase Auth + Storage (optional) ---
# When both NEXT_PUBLIC_SUPABASE_* values are set, sign-in switches to email magic links.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# With the service role key, uploads go browser -> Supabase Storage (bucket "uploads") and may be up to MAX_UPLOAD_MB.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public origin, used for share links, QR codes, emails, and OG images. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows the hidden /styleguide page when set to 1. Leave unset in production.
NEXT_PUBLIC_DEV_TOOLS=1
# Random 32+ character secret that signs session and draft cookies. Required in production.
DRAFT_COOKIE_SECRET=

# --- Limits (optional overrides; defaults in src/lib/config.ts) ---
# Max new materials per teacher per day. 0 or blank = unlimited.
DAILY_GENERATION_CAP=0
# Max upload size in megabytes.
MAX_UPLOAD_MB=

# --- Text-to-speech (optional) ---
# Leave unset to use the browser's built-in voices. Set to plug in a cloud voice later.
TTS_PROVIDER=
