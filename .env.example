# Copy to .env.local (gitignored). Never commit real values.

# --- Anthropic (server only) ---
# Required for real generation. Unset + MOCK_LLM=1 for local dev and tests.
ANTHROPIC_API_KEY=
# Optional: override the default fast model used for rewriting.
LLM_MODEL=
# Set to 1 to use deterministic fixtures instead of calling the API (all tests use this).
MOCK_LLM=1

# --- Supabase ---
# Project URL and anon key are safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only (Storage admin, demo seed). Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string from Supabase (Project settings -> Database -> Connection pooling, transaction mode, port 6543).
# All data access runs through this with RLS applied per request. Unset + MOCK_DB=1 runs an in-process Postgres (PGlite).
DATABASE_URL=
# Set to 1 to run on an in-process database with no Supabase at all (local dev, tests).
MOCK_DB=1

# --- App ---
# Public origin, used for share links, QR codes, emails, and OG images. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows the /styleguide page and the instant dev sign-in when set to 1. Set to 0 (or remove) in production.
NEXT_PUBLIC_DEV_TOOLS=1
# Random 32+ char secret used to sign the "try it before signing in" draft cookie. Required in production.
DRAFT_COOKIE_SECRET=

# --- Limits (optional overrides; defaults in src/lib/config.ts) ---
# Max new materials per teacher per day. 0 or blank = unlimited.
DAILY_GENERATION_CAP=0
# Max upload size in megabytes.
MAX_UPLOAD_MB=

# --- Text-to-speech (optional) ---
# Leave unset to use the browser's built-in voices. Set to plug in a cloud voice later.
TTS_PROVIDER=
